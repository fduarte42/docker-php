ARG TARGETARCH
ARG PHP_VERSION=7.4

# valkey glide needs a rust toolchain + cbindgen + protobuf compilers to compile glide's ffi core.
# Building it in its own stage keeps all of that out of the final image, which only gets the .so.
FROM debian:trixie-slim AS valkey-glide-builder
ARG TARGETARCH
ARG PHP_VERSION
ENV DEBIAN_FRONTEND=noninteractive
COPY build-valkey-glide.sh /build-valkey-glide.sh
RUN bash /build-valkey-glide.sh

FROM debian:trixie-slim
ARG TARGETARCH
ARG PHP_VERSION

ENV DEBIAN_FRONTEND=noninteractive

# Register the COMPOSER_HOME environment variable
ENV COMPOSER_HOME=/composer

# Add global binary directory to PATH and make sure to re-export it
ENV PATH=/composer/vendor/bin:$PATH

# Allow Composer to be run as root
ENV COMPOSER_ALLOW_SUPERUSER=1

# Set PHP session max lifetime
ENV PHP_GC_MAX_LIFETIME=1440

ENV DOCUMENT_ROOT=/

# pre-build
COPY config/keyboard /etc/default/keyboard
COPY scripts/.bashrc /root/.bashrc
COPY scripts/.bashrc /var/www/.bashrc
RUN chown -R www-data:www-data /var/www/.bashrc
COPY scripts/php-fpm-reload.sh /usr/local/bin/php-fpm-reload.sh
RUN chmod 755 /usr/local/bin/php-fpm-reload.sh

# build
# the valkey_glide .so is bind-mounted rather than COPYed: a COPY would leave a ~50MB
# layer behind even though build.sh only installs the file into the extension dir
COPY build-slim.sh /build-slim.sh
RUN --mount=type=bind,from=valkey-glide-builder,source=/out,target=/tmp/valkey-glide \
    bash /build-slim.sh && rm /build-slim.sh

# post-build
COPY scripts/cron-foreground /usr/local/bin/cron-foreground
RUN chmod 700 /usr/local/bin/cron-foreground
COPY scripts/docker-php-init /docker-php-init
RUN chmod 755 /docker-php-init
COPY config/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /var/www/html

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]
