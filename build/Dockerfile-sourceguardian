ARG PHP_VERSION=8.2
ARG BASE_IMAGENAME=fduarte42/docker-php
ARG FLAVOR=""
# set by build-all.sh -t so a per-arch build derives from the same-arch base tag
ARG TAG_SUFFIX=""
FROM ${BASE_IMAGENAME}:${PHP_VERSION}${FLAVOR}${TAG_SUFFIX}
ARG TARGETARCH
ARG PHP_VERSION=8.2

ENV DEBIAN_FRONTEND=noninteractive

# add sourceguardian loader (tarballs bind-mounted read-only, see Dockerfile-oci)
COPY add-sourceguardian.sh /add-sourceguardian.sh
RUN --mount=type=bind,source=extension,target=/tmp/vendor \
    bash /add-sourceguardian.sh && rm /add-sourceguardian.sh
