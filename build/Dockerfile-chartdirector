ARG PHP_VERSION=7.4
ARG BASE_IMAGENAME=fduarte42/docker-php
ARG FLAVOR=""
# set by build-all.sh -t so a per-arch build derives from the same-arch base tag
ARG TAG_SUFFIX=""
FROM ${BASE_IMAGENAME}:${PHP_VERSION}${FLAVOR}${TAG_SUFFIX}
ARG TARGETARCH
ARG PHP_VERSION=7.4

ENV DEBIAN_FRONTEND=noninteractive

# add chartdirector extension (tarballs bind-mounted read-only, see Dockerfile-oci)
COPY add-chartdirector.sh /add-chartdirector.sh
RUN --mount=type=bind,source=extension,target=/tmp/vendor \
    bash /add-chartdirector.sh && rm /add-chartdirector.sh
