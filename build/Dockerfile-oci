ARG PHP_VERSION=7.4
ARG BASE_IMAGENAME=fduarte42/docker-php
ARG FLAVOR=""
# set by build-all.sh -t so a per-arch build derives from the same-arch base tag
ARG TAG_SUFFIX=""
FROM ${BASE_IMAGENAME}:${PHP_VERSION}${FLAVOR}${TAG_SUFFIX}
ARG TARGETARCH
ARG PHP_VERSION=7.4

ENV DEBIAN_FRONTEND=noninteractive

# add oci packages
# the instant client zips are bind-mounted (read-only) rather than COPYed: a COPY would leave all of them,
# both arches, in a layer behind even though add-oci.sh only unpacks the matching pair
COPY add-oci.sh /add-oci.sh
RUN --mount=type=bind,source=driver/oracle,target=/tmp/vendor \
    bash /add-oci.sh && rm /add-oci.sh
