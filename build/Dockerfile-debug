ARG PHP_VERSION=7.4
ARG BASE_IMAGENAME=fduarte42/docker-php
ARG FLAVOR=""
# set by build-all.sh -t so a per-arch build derives from the same-arch base tag
ARG TAG_SUFFIX=""
FROM ${BASE_IMAGENAME}:${PHP_VERSION}${FLAVOR}${TAG_SUFFIX}
ARG TARGETARCH
ARG PHP_VERSION=7.4

ENV DEBIAN_FRONTEND=noninteractive

# add debug packages
COPY add-debug.sh /add-debug.sh
RUN bash /add-debug.sh && rm /add-debug.sh
